{
  "name": "spool",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/paperboytm/spool#readme",
  "bugs": {
    "url": "https://github.com/paperboytm/spool/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paperboytm/spool.git"
  },
  "type": "module",
  "scripts": {
    "build": "vp run rust-build",
    "check": "vp check && vp run rust-fmt-check && vp run rust-lint && vp run rust-test",
    "fix": "vp check --fix && vp run rust-fmt",
    "fmt": "vp fmt && vp run rust-fmt",
    "lint": "vp lint && vp run rust-lint",
    "test": "vp run rust-test",
    "up": "vp update --latest",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.13.0"
}
