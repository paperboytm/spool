{
  "name": "spool",
  "version": "0.5.2",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo build",
    "package": "turbo build --filter=@spool/app... && pnpm --filter @spool/app package",
    "package:mac": "turbo build --filter=@spool/app... && pnpm --filter @spool/app package:mac",
    "package:linux": "turbo build --filter=@spool/app... && pnpm --filter @spool/app package:linux",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "pretest": "pnpm run rebuild:native:node",
    "test": "turbo test --concurrency=1",
    "test:core": "pnpm --filter @spool-lab/core test",
    "test:e2e": "pnpm --filter @spool/app test:e2e",
    "test:share-backend": "pnpm --filter @spool/share-backend test",
    "rebuild:native:node": "pnpm --filter @spool-lab/core run rebuild:native:node",
    "rebuild:native:electron": "pnpm --filter @spool/app run rebuild:native:electron",
    "lint": "oxlint --type-aware .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "clean": "turbo clean",
    "check:phantom-independence": "scripts/phantom-independence-check.sh",
    "dev:install:mac": "scripts/dev-install-mac.sh",
    "spool": "node packages/cli/bin/spool.js"
  },
  "devDependencies": {
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "turbo": "^2.9.6",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "workerd",
      "acp-extension-codex-linux-x64"
    ],
    "peerDependencyRules": {
      "allowAny": [
        "vite",
        "vitest"
      ]
    },
    "overrides": {
      "pathe@catalog:": "^2.0.3",
      "wrangler@catalog:": "^4.0.0",
      "@cloudflare/workers-types@catalog:": "^4.20260415.1"
    }
  }
}
