{
  "name": "spool",
  "version": "0.6.3",
  "private": true,
  "homepage": "https://github.com/paperboytm/spool#readme",
  "bugs": {
    "url": "https://github.com/paperboytm/spool/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paperboytm/spool.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm -r --parallel run dev",
    "build": "vp run -r build",
    "package": "vp run --filter '@spool/app...' build && pnpm --filter @spool/app package",
    "package:mac": "vp run --filter '@spool/app...' build && pnpm --filter @spool/app package:mac",
    "package:linux": "vp run --filter '@spool/app...' build && pnpm --filter @spool/app package:linux",
    "typecheck": "vp run -r typecheck",
    "pretest": "pnpm run rebuild:native:node && pnpm --filter @spool/app run ensure:electron-runtime",
    "test": "vp run -r --concurrency-limit 1 test",
    "test:core": "pnpm --filter @spool-lab/core test",
    "test:e2e": "pnpm --filter @spool/app test:e2e",
    "test:share-backend": "pnpm --filter @spool/backend test",
    "rebuild:native:node": "pnpm --filter @spool-lab/core run rebuild:native:node",
    "rebuild:native:electron": "pnpm --filter @spool/app run rebuild:native:electron",
    "check": "vp check --fix",
    "lint": "vp lint --fix",
    "fmt": "vp fmt",
    "ci": "vp check && pnpm run test && pnpm run build",
    "up": "taze major -Ir",
    "clean": "vp run -r clean",
    "check:phantom-independence": "scripts/phantom-independence-check.sh",
    "dev:install:mac": "scripts/dev-install-mac.sh",
    "spool": "node scripts/spool-local.mjs",
    "prepare": "vp config"
  },
  "devDependencies": {
    "node-abi": "^4.33.0",
    "taze": "^19.14.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.14.0"
}
