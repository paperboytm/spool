{
  "name": "@spool/backend",
  "version": "0.0.1",
  "private": true,
  "homepage": "https://github.com/paperboytm/spool#readme",
  "bugs": {
    "url": "https://github.com/paperboytm/spool/issues"
  },
  "license": "MIT",
  "author": {
    "name": "xinyao",
    "email": "hi@xinyao.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paperboytm/spool.git"
  },
  "funding": "https://github.com/sponsors/xinyao27",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev ./public --inspector-port 9230 --d1 DB --kv SESSIONS --kv META --kv RATE --kv NONCE --r2 SNAPSHOTS --r2 OG --r2 AVATARS --r2 HUB",
    "deploy:staging": "wrangler pages deploy public --project-name spool-share-backend-staging",
    "deploy:prod": "wrangler pages deploy public --project-name spool-share-backend",
    "test": "vp test run",
    "typecheck": "tsc --noEmit",
    "d1:migrate:local": "wrangler d1 migrations apply spool-share-db --local",
    "d1:migrate:staging": "wrangler d1 migrations apply spool-share-db-staging --remote",
    "d1:migrate:prod": "wrangler d1 migrations apply spool-share-db --remote"
  },
  "dependencies": {
    "@spool-lab/session-kit": "workspace:*",
    "workers-og": "^0.0.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260718.1",
    "@spool-lab/cli": "workspace:*",
    "@types/node": "^26.1.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.112.0"
  }
}
