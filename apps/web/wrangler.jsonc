{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Keep the existing production service name so the first direct deploy can
  // replace its script without trying to steal the already-bound route.
  "name": "spool-pro-router",
  "main": "src/server.ts",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "spool.pro/*",
      "zone_name": "spool.pro",
    },
  ],
  "vars": {
    "ORIGIN_BACKEND": "https://spool-share-backend.pages.dev",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "env": {
    "staging": {
      "name": "spool-pro-router-staging",
      "routes": [
        {
          "pattern": "staging.spool.pro/*",
          "zone_name": "spool.pro",
        },
      ],
      "vars": {
        "ORIGIN_BACKEND": "https://spool-share-backend-staging.pages.dev",
      },
    },
  },
}
