    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.3",
    "undici": "^8.7.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.112.0"
