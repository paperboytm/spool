# Static assets are served before the Worker entrypoint, so preserve the
# route diagnostic header here. Dynamic web and API responses set it in code.
/*
  x-spool-route: web

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
