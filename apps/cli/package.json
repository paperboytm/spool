{
  "name": "@spool-lab/cli",
  "version": "0.6.0",
  "private": false,
  "homepage": "https://github.com/spool-lab/spool#readme",
  "bugs": {
    "url": "https://github.com/spool-lab/spool/issues"
  },
  "license": "MIT",
  "author": {
    "name": "xinyao",
    "email": "hi@xinyao.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spool-lab/spool.git"
  },
  "funding": "https://github.com/sponsors/xinyao27",
  "bin": {
    "spool": "./bin/spool.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./share": {
      "types": "./dist/commands/share.d.ts",
      "import": "./dist/commands/share.js"
    },
    "./resume": {
      "types": "./dist/commands/resume.d.ts",
      "import": "./dist/commands/resume.js"
    },
    "./hub": {
      "types": "./dist/hub/index.d.ts",
      "import": "./dist/hub/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vp test run --no-file-parallelism --maxWorkers=1",
    "prepack": "vp run build"
  },
  "dependencies": {
    "@spool-lab/core": "workspace:^",
    "@spool-lab/redact": "workspace:^",
    "@spool-lab/session-kit": "workspace:^",
    "commander": "^15.0.0",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "better-sqlite3": "11.10.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
