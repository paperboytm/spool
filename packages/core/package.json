{
  "name": "@spool-lab/core",
  "version": "0.6.0",
  "private": false,
  "homepage": "https://github.com/spool-lab/spool#readme",
  "bugs": {
    "url": "https://github.com/spool-lab/spool/issues"
  },
  "license": "MIT",
  "author": {
    "name": "xinyao",
    "email": "hi@xinyao.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spool-lab/spool.git"
  },
  "funding": "https://github.com/sponsors/xinyao27",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "rebuild:native": "pnpm run rebuild:native:node",
    "rebuild:native:node": "node ../../scripts/rebuild-better-sqlite3-node.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "bench:search": "vp run build && node scripts/benchmark-search-preview.mjs",
    "clean": "rm -rf dist",
    "prepack": "vp run build"
  },
  "dependencies": {
    "@effect/opentelemetry": "^0.64.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@spool-lab/redact": "workspace:*",
    "@spool-lab/session-kit": "workspace:^",
    "better-sqlite3": "11.10.0",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
