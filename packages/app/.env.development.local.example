# Local dev env for the Electron app — gitignored as `.env.*.local`.
# Copy to `.env.development.local` and fill in real values.
#
# Two concerns share this file:
#
#   1. Renderer feature flags (VITE_* prefix) — Vite inlines these into
#      `import.meta.env` for the renderer bundle.
#   2. Main-process env vars (SPOOL_* listed in MAIN_INLINE_ENV inside
#      electron.vite.config.ts) — electron-vite's loadEnv + define
#      substitutes `process.env.X` references in the main bundle with
#      the literal string at build time. Add to MAIN_INLINE_ENV when
#      introducing a new one.
#
# Why this isn't shared with packages/share-backend/.dev.vars:
# `.dev.vars` is wrangler-specific (Cloudflare Pages dev runtime).
# Electron's main process is a regular Node process and has its own
# bundling path. The *values* for shared OAuth client IDs are the
# same, but the runtimes don't share a loader.

# ── Renderer feature flags ─────────────────────────────────────────
# Pre-launch publish surface (Share popover Publish tab, Settings
# Account tab, Shares Published tab). Omit to keep them hidden.
VITE_FEATURE_SHAREPUBLISH=1

# ── Main-process OAuth ─────────────────────────────────────────────
# Desktop loopback PKCE client id. NOT a secret per RFC 8252; baked
# into the binary in prod. Get from Google Cloud Console → "Spool Dev"
# project → OAuth 2.0 Client IDs → Desktop app.
SPOOL_GOOGLE_CLIENT_ID_DESKTOP=

# Desktop "client_secret" from the SAME Google Cloud Console row as
# the desktop client id above (download the JSON to find it). Despite
# the name, Google's own docs acknowledge this isn't truly secret for
# distributed installed apps — the binary ships with it. It's required
# at the token endpoint though; without it Google rejects the exchange
# with `client_secret is missing`. Distinct from the WEB secret in
# share-backend/.dev.vars (different OAuth client row).
SPOOL_GOOGLE_CLIENT_SECRET_DESKTOP=

# Web client id — also exposed in main for the sign-in-with-id-token
# fallback path. Same value as in share-backend/.dev.vars
# GOOGLE_CLIENT_ID_WEB.
SPOOL_GOOGLE_CLIENT_ID_WEB=

# ── Main-process backend origin ────────────────────────────────────
# Where main posts to (sign-in-with-id-token, me, publish IPC, etc.).
# In dev this is the wrangler pages dev on 8788. In prod the binary
# defaults to https://spool.pro (DEFAULT_BACKEND in backend-url.ts);
# leave this blank in prod builds unless you're pointing at a staging
# environment.
SPOOL_SHARE_BACKEND=http://localhost:8788

# ── Renderer public share URL origin ───────────────────────────────
# The origin the renderer uses when constructing /s/<id> links shown
# to the user (Published row in Shares page, etc.). In dev this is
# the share-web vite server on 3002. In prod defaults to
# https://spool.pro via the resolver helper. Vite-inlined.
VITE_SPOOL_SHARE_PUBLIC_URL=http://localhost:3002
