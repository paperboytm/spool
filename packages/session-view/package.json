{
  "name": "@spool-lab/session-view",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && vite build && tailwindcss -i ./src/tailwind.css -o ./dist/styles.css --minify",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "lucide-react": "^1.8.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.6",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^1.29.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/node": "^22.19.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "mdast-util-to-string": "^4",
    "remark": "^15",
    "tailwindcss": "^4.0.0",
    "vite": "^6.3.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^3.2.4"
  }
}
