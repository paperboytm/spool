{
  "name": "@spool/share-kit",
  "version": "0.0.1",
  "private": true,
  "homepage": "https://github.com/spool-lab/spool#readme",
  "bugs": {
    "url": "https://github.com/spool-lab/spool/issues"
  },
  "license": "MIT",
  "author": {
    "name": "xinyao",
    "email": "hi@xinyao.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spool-lab/spool.git"
  },
  "funding": "https://github.com/sponsors/xinyao27",
  "files": [
    "dist",
    "src/styles"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./progressive": {
      "types": "./dist/progressive.d.ts",
      "development": "./src/progressive.ts",
      "import": "./dist/progressive.js"
    },
    "./timeline": {
      "types": "./dist/timeline.d.ts",
      "development": "./src/timeline.ts",
      "import": "./dist/timeline.js"
    },
    "./spool-document": {
      "types": "./dist/spool-document.d.ts",
      "development": "./src/spool-document.ts",
      "import": "./dist/spool-document.js"
    },
    "./styles.css": "./src/styles/global.css",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/fonts.css": "./src/styles/fonts.css"
  },
  "scripts": {
    "dev": "vp build --watch",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@spool-lab/redact": "workspace:*",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^1.25.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "lucide-react": "^0.460.0 || ^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0 || ^10.0.0",
    "remark-gfm": "^4.0.0"
  }
}
